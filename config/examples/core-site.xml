<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<!--
  Hadoop Core Configuration
  File: core-site.xml
  Location: $HADOOP_HOME/etc/hadoop/
  
  This file contains core Hadoop configuration properties.
  Replace placeholder values with your actual settings.
-->
<configuration>
    <!-- Default FileSystem -->
    <property>
        <name>fs.defaultFS</name>
        <value>hdfs://m-1:9000</value>
        <description>
            The default file system URI. This points to the NameNode.
            Used by all Hadoop components to access HDFS.
            Replace 'm-1' with your master node hostname.
        </description>
    </property>

    <!-- Temporary Directory -->
    <property>
        <name>hadoop.tmp.dir</name>
        <value>/home/hadoop/hadoop/tmp</value>
        <description>
            A base for other temporary directories.
            This directory is cleared on cluster restart.
            Ensure the path exists and is writable by the hadoop user.
        </description>
    </property>

    <!-- I/O File Buffer Size -->
    <property>
        <name>io.file.buffer.size</name>
        <value>131072</value>
        <description>
            Size of read/write buffer used in SequenceFiles.
            Default: 4096 (4KB)
            Recommended: 131072 (128KB) for better performance
            Larger values improve I/O performance but use more memory.
        </description>
    </property>

    <!-- User Permissions (optional - disable for development) -->
    <!--
    <property>
        <name>hadoop.security.authentication</name>
        <value>simple</value>
        <description>
            Authentication method: simple (default) or kerberos
            Use 'simple' for development, 'kerberos' for production
        </description>
    </property>
    -->

    <!-- Proxy User Settings (optional - for impersonation) -->
    <!--
    <property>
        <name>hadoop.proxyuser.hadoop.hosts</name>
        <value>*</value>
        <description>Allow hadoop user to proxy from any host</description>
    </property>
    <property>
        <name>hadoop.proxyuser.hadoop.groups</name>
        <value>*</value>
        <description>Allow hadoop user to proxy any group</description>
    </property>
    -->
</configuration>
